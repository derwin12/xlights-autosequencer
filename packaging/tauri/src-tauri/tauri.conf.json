{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xLightsAI",
  "version": "0.1.3",
  "identifier": "com.xlight.autosequencer",
  "build": {
    "beforeDevCommand": "cd ../../src/review/frontend && npm run dev",
    "beforeBuildCommand": "cd ../../src/review/frontend && npm ci && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../src/review/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "xLightsAI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../pyinstaller/plugins/vamp/x86_64-windows": "vamp",
      "binaries/backend-x86_64-pc-windows-msvc": "backend",
      "packaging-manifest.json": "packaging-manifest.json",
      "../../ReleaseNotes.txt": "ReleaseNotes.txt"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null,
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
